"""Memoria de Bridges en Hermes (plugin `bridges-memoria`).

installed by `bridges-mcp setup hermes`. Correr setup de nuevo lo sobrescribe: no lo
edites a mano. Fuente: github.com/Pepo2405/bridges mcp/src/integrations/hermes.py.tmpl

Hermes arranca en `~`, así que no sabe en qué proyecto vas a trabajar. Este plugin lo
detecta y le inyecta el contexto del proyecto (Decisiones vigentes + próximos pasos de la
última Bitácora) una vez por proyecto y por sesión:

- `transform_tool_result`: cuando una tool trabaja dentro de un repo con `.bridges`
  (terminal con workdir, read_file/patch/write_file/search_files con path, un `cd` en el
  comando), agrega el contexto al resultado de esa tool.
- `pre_llm_call`: si el mensaje del usuario nombra un repo con `.bridges` (o su ruta), lo
  inyecta antes de que el agente toque nada. Si el historial muestra una compactación nueva,
  vuelve a inyectar el contexto de los proyectos activos con el pedido de escribir la
  Bitácora (`log_session`).

Todo va al mensaje del usuario o al resultado de la tool, nunca al system prompt (no rompe
el prompt cache). Fail-open: si algo falla o tarda, no inyecta nada. Saltea subagentes.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import threading
import time
import unicodedata
from pathlib import Path
from typing import Any, Dict, List, Optional

CMD: List[str] = __BRIDGES_CMD__
TIMEOUT_S = 8
MAX_PROJECTS_PER_CALL = 2
COMPACTION_MARKER = "[CONTEXT COMPACTION"
INDEX_TTL_S = 300

_lock = threading.Lock()
_sessions: Dict[str, Dict[str, Any]] = {}
_index: List[Any] = []
_index_at = 0.0


def _code_dirs() -> List[Path]:
    raw = os.environ.get("BRIDGES_CODE_DIRS")
    if raw:
        return [Path(p).expanduser() for p in raw.split(os.pathsep) if p]
    return [Path.home() / "code"]


def _session(sid: Optional[str]) -> Dict[str, Any]:
    with _lock:
        return _sessions.setdefault(sid or "", {"injected": set(), "active": {}, "compactions": 0, "child": False})


def _norm(text: str) -> str:
    text = unicodedata.normalize("NFD", text)
    return "".join(c for c in text if unicodedata.category(c) != "Mn").lower()


def _read_marker(root: Path) -> Optional[Dict[str, str]]:
    try:
        data = json.loads((root / ".bridges").read_text(encoding="utf-8"))
        return data if isinstance(data, dict) and data.get("vault") else None
    except Exception:
        return None


def _project_key(root: Path) -> str:
    m = _read_marker(root) or {}
    return f"{m.get('vault', '')}|{str(m.get('folder', '')).strip('/')}" if m else str(root)


def _find_root(path: Path) -> Optional[Path]:
    """Directorio con `.bridges` más cercano subiendo desde `path` (archivo o carpeta)."""
    try:
        p = path.expanduser()
        if not p.is_absolute():
            return None
        p = p if p.is_dir() else p.parent
        home = Path.home()
        for d in [p, *p.parents]:
            if d == home or d == d.parent:
                return None
            if (d / ".bridges").is_file():
                return d
    except Exception:
        return None
    return None


def _repo_index() -> List[Any]:
    """[(regex, root)] de los repos con `.bridges` en ~/code (2 niveles), cacheado."""
    global _index, _index_at
    if _index and time.time() - _index_at < INDEX_TTL_S:
        return _index
    entries = []
    for base in _code_dirs():
        try:
            candidates = [d for d in base.iterdir() if d.is_dir() and not d.name.startswith(".")]
            candidates += [s for d in candidates for s in d.iterdir() if s.is_dir() and not s.name.startswith(".")]
        except Exception:
            continue
        for root in candidates:
            marker = _read_marker(root)
            if not marker:
                continue
            folder = str(marker.get("folder", "")).strip("/")
            names = {root.name}
            if folder:
                names.add(folder.split("/")[-1])
            else:
                names.add(str(marker["vault"]))
            for name in names:
                parts = [p for p in re.split(r"[-_\s]+", _norm(name)) if p]
                if not parts or len("".join(parts)) < 4:
                    continue
                pattern = r"(?<![\w-])" + r"[-_ ]?".join(re.escape(p) for p in parts) + r"(?![\w-])"
                entries.append((re.compile(pattern), root))
    _index, _index_at = entries, time.time()
    return entries


_PATH_RE = re.compile(r"(?:~|/Users/[^/\s]+|/home/[^/\s]+)/[^\s'\"`;|&()<>]+")


def _paths_in_text(text: str) -> List[Path]:
    return [Path(m).expanduser() for m in _PATH_RE.findall(text or "")]


def _roots_in_text(text: str) -> List[Path]:
    roots: List[Path] = []
    for p in _paths_in_text(text):
        r = _find_root(p)
        if r and r not in roots:
            roots.append(r)
    normalized = _norm(text or "")
    for rx, root in _repo_index():
        if root not in roots and rx.search(normalized):
            roots.append(root)
    return roots


def _roots_in_args(args: Any) -> List[Path]:
    if not isinstance(args, dict):
        return []
    cands: List[Path] = []
    for key in ("path", "workdir", "file_path", "cwd", "directory", "dir"):
        v = args.get(key)
        if isinstance(v, str) and v:
            cands.append(Path(v))
    cmd = args.get("command")
    if isinstance(cmd, str):
        cands += _paths_in_text(cmd)
    roots: List[Path] = []
    for c in cands:
        r = _find_root(c)
        if r and r not in roots:
            roots.append(r)
    return roots


def _project_context(root: Path, source: str) -> str:
    try:
        out = subprocess.run(
            [*CMD, "hook", "session-start"],
            input=json.dumps({"cwd": str(root), "source": source}),
            capture_output=True, text=True, timeout=TIMEOUT_S, cwd=str(root),
        )
        data = json.loads(out.stdout or "{}")
        return str(data.get("hookSpecificOutput", {}).get("additionalContext", "") or "")
    except Exception:
        return ""


def _inject(sess: Dict[str, Any], roots: List[Path], source: str, force: bool = False) -> str:
    parts: List[str] = []
    for root in roots[:MAX_PROJECTS_PER_CALL]:
        key = _project_key(root)
        with _lock:
            if key in sess["injected"] and not force:
                continue
            sess["injected"].add(key)  # se marca antes: aunque falle, no se reintenta en cada tool
        ctx = _project_context(root, source)
        if ctx:
            with _lock:
                sess["active"][key] = root
            parts.append(ctx)
    return "\n\n".join(parts)


def _text_of(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(str(p.get("text", "")) for p in content if isinstance(p, dict))
    return ""


def _on_pre_llm_call(session_id: str = "", user_message: Any = None, conversation_history: Any = None,
                     parent_session_id: str = "", **_: Any) -> Optional[Dict[str, str]]:
    try:
        sess = _session(session_id)
        if parent_session_id:
            sess["child"] = True
            return None
        parts: List[str] = []

        # Compactación nueva: lo inyectado antes quedó resumido. Re-inyectar con el pedido de Bitácora.
        history = conversation_history if isinstance(conversation_history, list) else []
        marks = [i for i, m in enumerate(history)
                 if isinstance(m, dict) and COMPACTION_MARKER in _text_of(m.get("content"))]
        if len(marks) > sess["compactions"]:
            recent = marks[-1] >= len(history) - 12  # una sesión vieja retomada no cuenta
            sess["compactions"] = len(marks)
            if recent:
                summary = _text_of(history[marks[-1]].get("content"))
                roots = list(sess["active"].values())
                roots += [r for r in _roots_in_text(summary) if r not in roots]
                with _lock:
                    sess["injected"] = set()
                ctx = _inject(sess, roots, "compact", force=True)
                if ctx:
                    parts.append(ctx)

        # El usuario nombra un proyecto: contexto antes de que el agente toque nada.
        roots = _roots_in_text(_text_of(user_message))
        ctx = _inject(sess, roots, "startup")
        if ctx:
            parts.append(ctx)
        return {"context": "\n\n".join(parts)} if parts else None
    except Exception:
        return None


def _on_transform_tool_result(tool_name: str = "", args: Any = None, result: Any = None,
                              session_id: str = "", **_: Any) -> Optional[str]:
    try:
        if not isinstance(result, str) or "bridges" in (tool_name or "").lower():
            return None
        sess = _session(session_id)
        if sess["child"]:
            return None
        roots = [r for r in _roots_in_args(args) if _project_key(r) not in sess["injected"]]
        if not roots:
            return None
        ctx = _inject(sess, roots, "startup")
        return f"{result}\n\n[Bridges · memoria del proyecto]\n{ctx}" if ctx else None
    except Exception:
        return None


def register(ctx) -> None:
    ctx.register_hook("pre_llm_call", _on_pre_llm_call)
    ctx.register_hook("transform_tool_result", _on_transform_tool_result)
