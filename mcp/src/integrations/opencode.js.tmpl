// installed by `bridges-mcp setup opencode`. Correr setup de nuevo lo sobrescribe:
// no lo edites a mano. Fuente: github.com/Pepo2405/bridges mcp/src/integrations/opencode.js
//
// Memoria de Bridges en OpenCode (equivalente al hook SessionStart del plugin de Claude
// Code): en repos con `.bridges` suma al system prompt las Decisiones vigentes y los
// próximos pasos de la última Bitácora. Al compactar, pide guardar la Bitácora con
// log_session hasta que el agente lo haga. Sin `.bridges` no hace nada.
import { spawn } from "node:child_process";

const CMD = __BRIDGES_CMD__;
const COMPACT_NOTE =
  "IMPORTANTE para el resumen compactado: incluí al principio esta instrucción para el agente: " +
  "\"Antes de seguir, guardá el handoff con la tool log_session de Bridges (Hecho y Próximos pasos) " +
  "y las decisiones que hayan quedado sin guardar con save_decision.\"";

/** Corre `<CMD> hook session-start` y devuelve el additionalContext ("" si no hay o falla). */
function projectContext(cwd, source) {
  return new Promise((resolve) => {
    let out = "";
    let done = false;
    const finish = (v) => { if (!done) { done = true; resolve(v); } };
    try {
      const child = spawn(CMD[0], [...CMD.slice(1), "hook", "session-start"], { cwd, stdio: ["pipe", "pipe", "ignore"] });
      const timer = setTimeout(() => { child.kill(); finish(""); }, 10000);
      child.stdout.on("data", (d) => { out += d; });
      child.on("error", () => { clearTimeout(timer); finish(""); });
      child.on("close", () => {
        clearTimeout(timer);
        try { finish(JSON.parse(out).hookSpecificOutput?.additionalContext ?? ""); } catch { finish(""); }
      });
      child.stdin.on("error", () => {});
      child.stdin.end(JSON.stringify({ cwd, source }));
    } catch {
      finish("");
    }
  });
}

export const BridgesMemoria = async ({ directory }) => {
  const cache = new Map(); // `${variante}` -> contexto (estable por sesión: no rompe el prompt cache)
  const compacted = new Set(); // sesiones compactadas que todavía no llamaron a log_session
  const children = new Set(); // subagentes: no se les inyecta nada

  const contextFor = async (sessionID) => {
    const source = compacted.has(sessionID) ? "compact" : "startup";
    if (!cache.has(source)) cache.set(source, await projectContext(directory, source));
    return cache.get(source);
  };

  return {
    event: async ({ event }) => {
      if (event.type === "session.created" || event.type === "session.updated") {
        const info = event.properties?.info;
        if (info?.id && info.parentID) children.add(info.id);
      }
    },
    "experimental.chat.system.transform": async (input, output) => {
      const sid = input.sessionID ?? "";
      if (children.has(sid)) return;
      const ctx = await contextFor(sid);
      if (!ctx) return;
      // Se concatena al último bloque: algunos modelos rechazan más de un mensaje system.
      if (output.system.length > 0) output.system[output.system.length - 1] += "\n\n" + ctx;
      else output.system.push(ctx);
    },
    "experimental.session.compacting": async (input, output) => {
      if (children.has(input.sessionID)) return;
      if (!(await contextFor(input.sessionID))) return; // repo sin .bridges
      compacted.add(input.sessionID);
      output.context.push(COMPACT_NOTE);
    },
    "tool.execute.after": async (input) => {
      if (/log_session$/.test(input.tool)) compacted.delete(input.sessionID);
    },
  };
};
